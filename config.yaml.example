
paths:
  # Path for generated feeds
  # Each use of these has an optional boolean: "relative_to_X_path"
  #  - true : use this path
  #  - false or absent: use absolute path
  # At this point each of these folders needs to exist beforehand
  cache_path: /tmp/google_calendar_helpers/cache
  publish_path: /tmp/google_calendar_helpers/rss
  log_path: /tmp/google_calendar_helpers/logs
  dump_path: /tmp/dump # Usually overwritten in args (not implemented yet)

  # Where to find a venv to use
  # This really should be specified!
  venv_path: /home/pnijjar/src/google-calendar-helpers/venv

  # Where to store tweets/toots/skeets to publish. 
  tweet_cache_path: /tmp/google_calendar_helpers/cache/tweets

  # Where to keep cached json
  # This replaces OUT_EVENT_DICT
  cache_file: 
    name: eventbrite-events-processed.json 
    relative_to_cache_path: true


services:
  google:
    # Go to https://console.developers.google.com to generate this. You
    # need to enable it for the Google Calendar API
    api_key: 'Insert-your-API-key-here'

    calendar_ids:
      - 'nlkc39jt4p0nbc4pk9pj7p5fh0@group.calendar.google.com'

  twitter:
    # This is for the Twitter API. Generate it from developers.twitter.com
    # You only need it if you are sending tweets from the calendar
    consumer_key: 'Insert-Your-Twitter-Consumer-Key'
    consumer_secret: 'Insert-Your-Twitter-Consumer-Secret'
    access_token: 'Insert-Your-Twitter-Access-Token'
    access_secret: 'Insert-Your-Twitter-Access-Secret'
    enable: false

  mastodon: 
    # Go to your profile, go to the "development" section, 
    # make a new application with write:status
    # permissions (and maybe profile?) and get the access 
    access_token: 'Insert-Your-Mastodon-Access-Token'
    server: 'examplemastodon.social'
    enable: false

  bluesky:
    # https://bsky.app/settings/app-passwords
    app_password: 'Insert-Your-App-Password-Here'
    pds: 'https://bsky.social'
    handle: 'example.bsky.social'
    enable: false

  # See https://github.com/ellisonleao/pyshorteners/ for the
  # syntax of making a new shortener.
  # Note that the syntax has changed dramatically since v0.6.1
  # (Uh oh. How does this become YAML?)

  # To see the services:
  #   source venv/bin/activate
  #   python3
  #   import pyshorteners
  #   s = pyshorteners.Shortener()
  #   print(s.available_shorteners)
  #
  # Another non-pyshorteners option is available: liteshort
  # This requires a domain parameter:
  #   params:
  #     domain: 'https://s.kwlug.org'
  # To use no shortener: use 'no_shortener'
  shortener: 
    service: 'dagd'
    params: {}
  


feeds:
  # Website that hosts these feeds
  website: https://feeds.example.com

  # Logo for RSS feed
  logo_url: https://feeds.example.com/img/logo.png

  # These get published in the RSS feeds
  webmaster: admin@example.com
  webmaster_name: "Webmaster"

  # For datetime nonsense
  timezone: "America/Toronto"

  # What is the currency used in this application? I guess you are in 
  # trouble if there are multiple currencies. You can probably be more
  # sophisticated by translating the currency code (eg "CAN") to a
  # symbol, but this is good enough for me. 
  currency_symbol: '$'

  # How many items should be in the feed?
  num_items: 100

  rss:
    title: 'WatCamp Events'
    description: >
      Upcoming tech events in Waterloo Region.
      The description can be multiple lines.

    # For "filename" entries: use 'stdout' to publish to stdout with 
    # no file. (Ugh type theory, but whatevs.)
    
    # filenames SHOULD include extensions now.
    filename: /var/www/html/rss/watcamp.rss
    relative_to_publish_path: false

    # There is a DRY violation here. watcamp.rss is specified twice.
    # I think this set should only be needed for RSS (and iCal?)
    # It is used to generate the "atom:link rel="self" in the RSS
    # feed. If it is relative to the website there is no need for 
    # a leading slash.
    url: rss/watcamp.rss
    relative_to_website: true

    # How should recurring events be handled? Options:
    # 'nothing' : No events that are marked as recurring are 
    #    included
    # 'everything' : Include everything. This may include events 
    #    long into the future.
    # 'next' : Include the next upcoming event. 
    include_recurring: 'next'

  newsletter:
    # How many days back should the newsletter display? 
    # Use 1 for just today, -1 for no limit.
    max_days: 14

    header: >
      Welcome to the watcamp.com newsletter. To contribute events to
      the calendar, use the Contact functionality on the website. To
      unsubscribe, reply to this message with the subject
      "unsubscribe", or visit the mailing list website.

      Note that "Learn More" links point to our Google Calendar, not
      to the event sites directly (but those event sites are usually
      accessible from our calendar).

    # filenames SHOULD include extensions now.
    filename: watcamp.txt
    relative_to_publish_path: true


  sidebar: 
    # For "filename" entries: use 'stdout' to publish to stdout with 
    # no file. (Ugh type theory, but whatevs.)

    #filename: watcamp-sidebar.html
    filename: stdout

    # This is not used if stdout is specified. It can probably be
    # deleted.
    relative_to_publish_path: True 


  tweets: 
    # Maybe this should be shared with toots?

    # How many days in advance should we tweet events, and 
    # how should they be labelled?
    date_expression:
      0: "Today!"
      1: "Tomorrow!"
      3: "Three sleeps!"
      7: "Next week!"

    # How many days in advance should we grab tweets (upper bound).
    # Use 8 for events one week from now. 0 is today.
    days_in_advance: 8

    # What hours of the day should we release tweets? 
    # These parameters define a window when we are allowed to 
    # actually send the tweets.
    #
    # If you run the script in between the start and end window then
    # we try to schedule tweets in the remaining time.
    # 
    # If you run the script after the end window then we schedule
    # tweets as if we are generating them the next day. 
    # 
    # Probably you should run the script before the start window.
    window:
      start: '09:00'
      end: '16:00'

logging:
  logfile: gcal_helper.log
  relative_to_log_path: true

  loglevel_file: info
  loglevel_display: error
  
  # In kb?
  max_logfile_size: 1024000
  num_logfiles_to_keep: 5


# You probably do not want to set these in the YAML, but you do you.
# They correspond to commandline args.
flags:
  limit_fetch: false # --small parameter (not implemented yet)
  skip_api: false    # --skip-api (not implemented yet)
  dump: false        # true if --dump-dir is set (not implemented yet)
  tweet_id: -1       # Only for send_tweet       
  toot_id: -1        # Only for send_toot (not implemented yet)


# Same with these
internal:
  config_location: None
  
